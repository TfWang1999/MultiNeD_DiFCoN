    "source_rate_scale": {
      "low": 0.4,
      "high": 1.3,
      "mapping": "log"
    },
    "lambda_act_scale": {
      "low": 0.3,
      "high": 1.2,
      "mapping": "log"
    }
  },
  "fitted_baseline": {
    "tumor_k": 5999.998046875,
